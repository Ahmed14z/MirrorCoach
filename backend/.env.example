# MirrorCoach AI Backend Environment Variables

# Required: Your Gemini API Key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Configuration
# For Live API with video input + audio output (requires billing):
# - gemini-2.5-flash-native-audio-preview-12-2025 (recommended)
# For Live API with video input + text output only:
# - gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Session Configuration (max duration in seconds)
MAX_SESSION_DURATION=900

# CORS (comma-separated origins)
ALLOWED_ORIGINS_STR=http://localhost:3000,http://127.0.0.1:3000
